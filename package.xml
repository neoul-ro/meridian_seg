<?xml version="1.0"?>
<package format="3">
  <name>meridian_seg</name>
  <version>0.1.0</version>
  <description>FastSAM segmentation node for the Meridian perception pipeline: rgb8 image in, mono8 segment label image out.</description>
  <maintainer email="a_o@kakao.com">blu-y</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- seg_node -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>ament_index_python</depend>

  <!-- torch / torchvision / tensorrt 는 여기 적지 않는다. rosdep 규칙이
       CUDA 빌드를 구분하지 못해서(cpu 휠이 깔린다) 오히려 망가진다.
       README의 "설치"에 검증된 버전과 설치 명령을 적어두었다. -->

  <!-- meridian_msgs 는 rosdep에 없다. github.com/neoul-ro/meridian_msgs 를
       같은 워크스페이스에 clone해야 한다. -->
  <depend>meridian_msgs</depend>

  <!-- geobuilder_node (선택적으로 seg.launch.py가 같이 띄운다) -->
  <depend>sensor_msgs_py</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
